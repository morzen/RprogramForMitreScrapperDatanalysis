colClasses = list(character = "APTname"))  # Ensure APTname loads as character
# 2. Strategic level reduction with type safety
reduce_levels <- function(x, min_obs = 5) {
if (is.character(x) || is.factor(x)) {
x <- as.character(x)
freq <- table(x)
levels_to_merge <- names(freq)[freq < min_obs]
if (length(levels_to_merge) > 0) {
