# 2. Strategic level reduction with type safety
reduce_levels <- function(x, min_obs = 5) {
if (is.character(x) || is.factor(x)) {
x <- as.character(x)
freq <- table(x)
levels_to_merge <- names(freq)[freq < min_obs]
if (length(levels_to_merge) > 0) {
x[x %in% levels_to_merge] <- "MERGED_LEVEL"
}
return(as.factor(x))
}
return(x)
}
View(reduce_levels)
# 3. Convert ALL columns to appropriate types
data_clean <- copy(raw_data)
# First ensure APTname is factor (your target variable)
data_clean[, APTname := as.factor(APTname)]
# Then process other columns
cols_to_reduce <- setdiff(names(data_clean), "APTname")
data_clean[, (cols_to_reduce) := lapply(.SD, reduce_levels, min_obs = 10),
.SDcols = cols_to_reduce]
# 4. Verify all variables are bnlearn-compatible
stopifnot(all(sapply(data_clean, function(x) is.factor(x) || is.numeric(x))))
View(data_clean)
