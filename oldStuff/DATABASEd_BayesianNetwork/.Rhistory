#####################################################
library(data.table)
library(bnlearn)
library(Rgraphviz)
# 1. Load data with type control
raw_data <- fread("./dataforBayesiaNetwork/TestFinal_df.csv",
na.strings = c("", "NA", "NULL", "\\N"),
colClasses = "character") # Load all as character initially
# 2. Enhanced level reduction with column-specific rules
reduce_levels <- function(x, colname, min_obs = 5, max_levels = 100) {
if (!is.character(x)) return(x)
freq <- sort(table(x), decreasing = TRUE)
# Special handling for different column types
if (colname == "APTname") {
# Keep top N APTnames plus "OTHER_APT"
top <- names(freq)[1:min(max_levels, length(freq))]
x[!x %in% top] <- "OTHER_APT"
}
else if (grepl("CVE|Pulse", colname)) {
# Shorten ID-based columns
x <- substr(x, 1, 10)
}
else {
# Generic column handling
top <- names(freq)[freq >= min_obs]
if (length(top) > max_levels) top <- top[1:max_levels]
x[!x %in% top] <- "MERGED_LEVEL"
}
return(as.factor(x))
}
# 3. Apply level reduction column-wise
data_clean <- raw_data[, Map(reduce_levels, .SD, names(.SD)),
.SDcols = names(raw_data)]
data_clean <- na.omit(data_clean)
# 4. Verify factor levels
level_counts <- sapply(data_clean, function(x) if(is.factor(x)) length(levels(x)) else NA)
print(level_counts)
# 5. Network learning with safeguards
tryCatch({
bn_model <- hc(data_clean,
score = "pnal",
restart = 3,
max.iter = 500,
maxp = 2)
}, error = function(e) {
message("Falling back to BDE score due to pnal error")
bn_model <<- hc(data_clean, score = "bde", iss = 10)
})
gc()
