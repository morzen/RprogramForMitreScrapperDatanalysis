library(data.table)
library(bnlearn)
library(Rgraphviz)
# 1. Load data with type control
raw_data <- fread("./dataforBayesiaNetwork/TestFinal_df.csv",
na.strings = c("", "NA", "NULL", "\\N"),
colClasses = "character")
# 2. Smart level reduction preserving key relationships
reduce_levels <- function(x, colname) {
if (!is.character(x)) return(x)
# Column-specific handling
if (colname == "APTname") {
top <- names(sort(table(x), decreasing = TRUE)[1:50]) # Keep top 50 APTs
x[!x %in% top] <- "OTHER_APT"
}
else if (colname == "techniques_str") {
x <- substr(x, 1, 6) # Shorten technique IDs
}
else if (colname %in% c("CAPEC_ID", "CWE_ID")) {
x <- paste0(substr(colname, 1, 3), substr(x, nchar(x)-3, nchar(x))) # Keep last 3 digits
}
else if (grepl("CVE|Pulse", colname)) {
x <- substr(x, 1, 8) # Shorten long IDs
}
else {
top <- names(sort(table(x), decreasing = TRUE)[1:30]) # Default: keep top 30
x[!x %in% top] <- "OTHER"
}
as.factor(x)
}
# 3. Apply smart reduction
data_clean <- raw_data[, Map(reduce_levels, .SD, names(.SD))] %>% na.omit()
